# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required to analyze videos and run briefs.

# Claude (required). Where ANTHROPIC_API_KEY is reserved by the host, set HALO_ANTHROPIC_API_KEY instead.
ANTHROPIC_API_KEY=
HALO_CLAUDE_MODEL=claude-opus-5-5

# Sources: YouTube Data API key (Google Cloud console). Instagram uses per-creator tokens
# from Instagram Login, stored on each creator account.
HALO_YOUTUBE_API_KEY=

# Speech-to-text for creator videos (optional; without it Halo judges from frames + caption)
HALO_ELEVENLABS_API_KEY=

# Embeddings for "more like this" and smarter search (optional; without it Halo uses tag overlap)
HALO_VOYAGE_API_KEY=

# Telegram bot from @BotFather (optional; powers creator sign-up and brand alerts)
HALO_TELEGRAM_BOT_TOKEN=
HALO_TELEGRAM_BOT_USERNAME=halo_uz_bot

# Change this in every real deployment: it signs the brand <-> Telegram link codes
HALO_SECRET_KEY=change-me

# Local development without Docker (Docker Compose sets these itself)
# HALO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/halo
# HALO_REDIS_URL=redis://localhost:6379/0
